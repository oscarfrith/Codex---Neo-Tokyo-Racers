# Neo Tokyo Racers Roblox repo hygiene

# Keep the repo focused on the curated handoff folders.
# The root folder contains many historical command-bar patch scripts; the latest
# important scripts are copied into /scripts.
/roblox_hover_racing*.lua

# OS/editor noise
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.temp
*.bak
*.backup
*.log

# Roblox Studio local/autosave-style files
*.autosave
*.rbxl.lock
*.rbxlx.lock

# Assistant local scratch/settings (project .claude/settings.json, commands and agents are tracked)
.codex/
.claude/settings.local.json
CLAUDE.local.md
BACKUPS_*/
*_Backup_*
__pycache__/
*.pyc

# Reproducible local architecture build previews; the Studio mirror is tracked.
scripts/architecture_phase3/projected/
scripts/architecture_phase4/projected/
# Vehicle frame-class blockout previews: regenerate with scripts/vehicle_blockouts/preview.py.
scripts/vehicle_blockouts/previews/
scripts/vehicle_blockouts/showroom/

# Temporary Roblox Studio export paste blob.
docs/studio-script-export-paste.txt
docs/studio-full-export-paste.txt

# Archived legacy Studio scripts are documented, but their exported mirror paths
# can exceed Windows/Git path limits and are not needed as live source.
roblox/exported_scripts/ServerStorage/NeoTokyoRacers_LegacyArchive/

# Keep these project folders tracked
!/docs/
!/scripts/
!/diagrams/
!AGENTS.md
!CLAUDE.md
!/.claude/
!README.md
# Exotic category: generated installers (rebuild with feature_installer.py / stage_b/build_content.py).
scripts/exotic_category/stage_a/out/
scripts/exotic_category/stage_b/out/
# Exotic mesh pilot: generated exports (rebuild with scripts/exotic_category/mesh/export.py).
scripts/exotic_category/mesh/export/
